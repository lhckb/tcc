   "source": [
    "for dist, model in zip(list_of_cuml_returns[:-1], list_of_models):\n",
    "    _, normality_p_value = shapiro_wilk_gaussian_test(dist)\n",
    "    alpha = 0.05\n",
    "\n",
    "    if normality_p_value < alpha: # reject H0\n",
    "        wilcoxon_signed_rank(dist, rg_cuml_returns_dist, \"less\")\n",
    "    else: # do not reject H0\n",
    "        _, bart_p = bartlett_variances([dist, rg_cuml_returns_dist])\n",
    "        equal_var = bart_p >= alpha  # null has not been rejected\n",
    "        ttest_2(dist, rg_cuml_returns_dist, \"less\", equal_variances=equal_var)\n",
    "    \n",
    "    mean1_value = np.mean(dist)\n",
    "    mean2_value = np.mean(rg_cuml_returns_dist)\n",
    "\n",
    "    plt.figure(figsize=(8, 5))\n",
    "    # Plot distributions\n",
    "    sns.kdeplot(dist, label=f\"Distribuição do {model}\", color=model_colors[model], fill=True, alpha=0.3)\n",
    "    sns.kdeplot(rg_cuml_returns_dist, label=f\"Distribuição do Modelo Aleatório\", color=model_colors[\"MA\"], fill=True, alpha=0.3)\n",
    "\n",
    "    # Mark means\n",
    "    plt.axvline(mean1_value, color=model_colors[model], linestyle=\"dashed\", linewidth=2, label=f\"Média do {model}\")\n",
    "    plt.axvline(mean2_value, color=model_colors[\"MA\"], linestyle=\"dashed\", linewidth=2, label=f\"Média do MA\")\n",
    "\n",
    "    # Labels and legend\n",
    "    plt.xlabel(\"Retornos\")\n",
    "    plt.ylabel(\"Densidade\")\n",
    "    plt.title(f\"Retorno cumulativo: {model} vs. Modelo Aleatório\")\n",
    "    plt.legend()\n",
    "    plt.show()\n",
    "    "
   ]
  },
